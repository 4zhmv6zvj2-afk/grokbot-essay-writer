#!/bin/sh
# Install with: git config core.hooksPath .githooks
# This hook does not use pre-commit. CI covers pull-request branches.
# The fast gate runs only when this push updates main.

root=$(git rev-parse --show-toplevel) || exit 2
cd "$root" || exit 2

updates_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main) updates_main=1 ;;
    esac
done

if [ "$updates_main" -eq 0 ]; then
    echo "pre-push: not updating main, so the fast gate is skipped. CI covers pull-request branches."
    exit 0
fi

python tools/run_gates.py
status=$?
if [ "$status" -ne 0 ]; then
    echo "pre-push: the fast gate failed, so this push was refused."
    echo "Emergency path: git push --no-verify"
    echo "Never use it to publish a tag."
    exit "$status"
fi
exit 0
