# Specialist local development only. Copy to .env if you need it.
# Ordinary setup does not read this file. The Consensus key, plan, and
# Unpaywall email are collected on the secret card. See FIRST-RUN.txt.
# Leave values empty. Do not commit a real key, email, or token.

CONSENSUS_API_KEY=
ESSAY_WRITER_UNPAYWALL_EMAIL=
ESSAY_WRITER_CONSENSUS_PAID=0
# 0 keeps the run log and ml-events.jsonl off. 1 turns both on for operators.
# Students leave this at 0. There is no separate switch for the event stream.
ESSAY_WRITER_DEBUG=0

# Optional. 0 turns Consensus off even when a key is present.
# 1 allows Consensus when a key is present. Leave unset to follow the key.
# ESSAY_WRITER_CONSENSUS=

# Optional folder overrides. Leave unset unless you need them.
# ESSAY_WRITER_ROOT=
# ESSAY_WRITER_MAC_DIR=
